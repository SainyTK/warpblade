{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "index.html", "patches/index.html", "*.json", "*.ts", "!!agent-studio", "!!studio"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/heroes/*/motion/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/**", "!src/heroes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/heroes/*/**"],
                    "message": "Shared code reaches a hero only through the roster (src/heroes/roster.ts) and the hero registry (src/heroes/registry.ts), never a file inside a hero's folder (docs/hero-module.md)."
                  }
                ],
                "paths": {
                  "../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/scene/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/heroes/*/**"],
                    "message": "Shared code reaches a hero only through the roster (src/heroes/roster.ts) and the hero registry (src/heroes/registry.ts), never a file inside a hero's folder (docs/hero-module.md)."
                  }
                ],
                "paths": {
                  "../game/state": {
                    "importNames": ["rng"],
                    "message": "Scene drawing reads fxRng for effects and never the play generator rng (docs/graphics.md)."
                  },
                  "../../game/state": {
                    "importNames": ["rng"],
                    "message": "Scene drawing reads fxRng for effects and never the play generator rng (docs/graphics.md)."
                  },
                  "../../../game/state": {
                    "importNames": ["rng"],
                    "message": "Scene drawing reads fxRng for effects and never the play generator rng (docs/graphics.md)."
                  },
                  "../../../../game/state": {
                    "importNames": ["rng"],
                    "message": "Scene drawing reads fxRng for effects and never the play generator rng (docs/graphics.md)."
                  },
                  "../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  },
                  "../../../../../heroes": {
                    "message": "Shared code reads hero code through heroModule from src/heroes/registry.ts and never imports the hero modules, so no shared module loads a hero while it loads itself (docs/hero-module.md)."
                  }
                }
              }
            }
          },
          "performance": {
            "noNamespaceImport": "error"
          }
        }
      }
    },
    {
      "includes": ["src/heroes/roster.ts", "src/heroes/stub.ts", "src/rig/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/game/**", "**/ui/**", "**/store/**", "**/scene/**", "**/services/**"],
                    "message": "A hero's data (character.ts, constants, look, types) and the rig stay free of game state: they import constants, types, utils, the engine and the rig only, and no other hero's folder (docs/hero-module.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
