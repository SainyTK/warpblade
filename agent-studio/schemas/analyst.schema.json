{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "impact": {
            "enum": ["high", "medium", "low"]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["id", "impact", "reason"]
      }
    },
    "picks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "sample": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "heroes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runs": {
                "type": "integer",
                "minimum": 1
              },
              "minutes": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": ["heroes", "stages"]
          }
        },
        "required": ["id", "sample"]
      }
    }
  },
  "required": ["measures", "picks"]
}
