{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "enum": ["big", "small"]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["video", "image"]
              },
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.(mp4|png)$"
              },
              "poster": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.png$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["kind", "file", "alt", "width", "height"]
          }
        },
        "required": ["title", "text", "media"]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": ["heroes", "foes", "stages", "systems", "items", "art", "bugfixes"]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "enum": ["new", "buff", "nerf", "adjusted", "rework", "fix"]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "stat"
                          },
                          "label": {
                            "type": "string"
                          },
                          "before": {
                            "type": "string"
                          },
                          "after": {
                            "type": "string"
                          }
                        },
                        "required": ["kind", "label", "before", "after"]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "note"
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": ["kind", "text"]
                      }
                    ]
                  },
                  "minItems": 1
                },
                "media": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": ["video", "image"]
                    },
                    "file": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+\\.(mp4|png)$"
                    },
                    "poster": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+\\.png$"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": ["kind", "file", "alt", "width", "height"]
                },
                "feedback": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              },
              "required": ["name", "tag", "summary", "context", "changes"]
            },
            "minItems": 1
          }
        },
        "required": ["id", "entries"]
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": ["id", "summary"]
      }
    }
  },
  "required": ["version", "kind", "date", "title", "tagline", "intro", "highlights", "sections", "feedback"],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
