{
  "name": "warpblade-agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The agent game studio that plans, builds, tests and ships Warpblade patches.",
  "scripts": {
    "studio": "tsx src/cli.ts",
    "playtest": "tsx playtest/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright-core": "1.64.1"
  }
}
