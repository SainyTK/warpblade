{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warpblade-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warpblade-feedback",
      // The owner replaces this with the id printed by `wrangler d1 create warpblade-feedback`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
