{
  "name": "warpblade-feedback-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "db:migrate:local": "wrangler d1 migrations apply warpblade-feedback --local",
    "db:migrate:remote": "wrangler d1 migrations apply warpblade-feedback --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
